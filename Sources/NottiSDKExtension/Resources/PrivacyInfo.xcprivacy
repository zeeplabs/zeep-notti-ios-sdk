<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  No required-reason API: the file size check uses URLResourceKey.fileSizeKey,
	  not a file timestamp API (attributesOfItem was dropped, nse-rich-media D9).
	  Adding one back means declaring its category here in the same change (PKG-13).
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyTracking</key>
	<false/>
</dict>
</plist>
